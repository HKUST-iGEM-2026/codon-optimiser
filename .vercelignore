# Python functions bundle every project file that is reachable at build time — there
# is no tree-shaking — so anything the request path does not need is dead weight in
# the bundle and in the cold start.
.venv/
.work/
.tools/
.pytest_cache/
__pycache__/
*.pyc

# Offline table builder: run by hand, never imported by app/.
pipeline/
tests/

# Other deployment targets and CI.
Dockerfile
.github/

# Local test configuration only, and its presence changes how the platform resolves
# dependencies: Vercel prefers pyproject.toml over requirements.txt and then runs
# `uv lock`, which fails on a file with no [project] table. Dependencies live in
# requirements.txt, in one place, so keep this out of the deployment.
pyproject.toml

# Never upload a permalink database.
data/permalinks.sqlite
